	(text "The LCD_ signals connect to the Microcontroller page.\nPin map: LCD_CS = PA4 (SPI1_CS), LCD_SCK = PA5 (SPI1_SCK), LCD_MISO = PA6 (SPI1_MISO), LCD_MOSI = PA7 (SPI1_MOSI),\nLCD_RST = PB0, LCD_INT = PB1, LCD_WAIT = PA0."
		(exclude_from_sim no)
		(at 43.18 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a588c4d2-c392-49d7-98d3-e68ff0e44439")
	)
	(text "33R series resistors damp SPI edges. The 10k pull-up keeps chip select high while the MCU is in reset."
		(exclude_from_sim no)
		(at 43.18 148.59 0)
		(effects
