	(text "Pin names on this page (used by other pages):\nLCD_CS = PA4 (SPI1_CS)     LCD_SCK = PA5 (SPI1_SCK)     LCD_MISO = PA6 (SPI1_MISO)     LCD_MOSI = PA7 (SPI1_MOSI)\nLCD_RST = PB0     LCD_INT = PB1     LCD_WAIT = PA0\nBTN1-BTN5 = PB10, PB11, PB12, PB14, PA8 (steering wheel inputs)     CANTX = PB9     CANRX = PB8\nPins with an X are unused on purpose."
		(exclude_from_sim no)
		(at 43.18 160.02 0)
