		(uuid "1d303321-528c-4b0a-861a-75e46901e10f")
	)
	(text "Pin names on this page (used by other pages):\nDIAL4 = PA4 = SPI1_CS     DIAL5 = PA5 = SPI1_SCK     DIAL6 = PA6 = SPI1_MISO     DIAL7 = PA7 = SPI1_MOSI\nDIAL8 = PB0 = display RST     DIAL9 = PB1 = display INT     DIAL0 = PA0 = display WAIT\nBTN1-BTN5 = PB10, PB11, PB12, PB14, PA8 = steering wheel inputs     CANTX = PB9     CANRX = PB8\nPins with an X are unused on purpose."
		(exclude_from_sim no)
		(at 48.26 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3aab3c58-1bc8-4496-a76c-0b71fd98f749")
	)
	(text "1x bulk decoupling + 100nF per VDD pin"
		(exclude_from_sim no)
		(at 55.88 57.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3db992f1-544e-4674-9cfe-8b15326caf56")
	)
